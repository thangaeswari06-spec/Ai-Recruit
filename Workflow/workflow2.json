      "name": "AI Candidate Evaluation (Inline)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1376,
        208
      ],
      "onError": "continueRegularOutput",
      "continueOnFail": true,
      "alwaysOutputData": true,
      "credentials": {
