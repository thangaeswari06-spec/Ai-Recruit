    {
      "parameters": {
        "jsCode": "const text = ($json.text || '').replace(/\\s+/g, ' ').replace(/\\u0000/g, '').trim();\nconst webhookData = $('Resume Upload (Webhook)').first().json.body || {};\nreturn [{ json: {\n  resume_text: text.slice(0, 15000),\n  name: webhookData.candidate_name || webhookData.name || '',\n  email: webhookData.candidate_email || webhookData.email || '',\n  phone: webhookData.candidate_phone || webhookData.phone || '',\n  location: webhookData.location || '',\n  job_id: webhookData.job_id || null,\n  resume_url: webhookData.resume_url || ''\n} }];"
      },
