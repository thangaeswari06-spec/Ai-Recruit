    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet s;\ntry {\n  const raw = input.choices[0].message.content;\n  s = JSON.parse(raw);\n} catch (e) {\n  s = {};\n}\n// Guard: malformed/missing AI fields fall back to 0 instead of NaN -> NULL\nconst skills = Number(s.skills_score) || 0;\nconst experience = Number(s.experience_score) || 0;\nconst projects = Number(s.projects_score) || 0;\nconst weighted = Math.round((skills*0.4) + (experience*0.35) + (projects*0.25));\nconst recommendation = weighted >= 80 ? 'Shortlist Recommended' : weighted >= 60 ? 'Review Required' : 'Not Recommended';\nconst application = $('Insert Application (Raw SQL)').first().json;\nreturn [{ json: {\n  application_id: application.id,\n  weighted_score: weighted,\n  ai_summary: `Skills: ${skills} | Experience: ${experience} | Projects: ${projects} | Recommendation: ${recommendation}`,\n  matched_skills: s.matched_skills || [],\n  missing_skills: s.missing_skills || []\n} }];"
      },
      "id": "797e0ee9-6e41-42bf-9ad1-ea0fb9d52e7b",
      "name": "Calculate Weighted Score (Inline)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        208
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE applications SET score = $1, ai_summary = $2, matched_skills = $3, missing_skills = $4\nWHERE id = $5\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [ $json.weighted_score, $json.ai_summary, $json.matched_skills, $json.missing_skills, $json.application_id ] }}"
        }
      },
      "id": "0679b134-a187-44f0-bafc-392851bd0129",
