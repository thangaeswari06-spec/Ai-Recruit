        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'mistral-large-latest', temperature: 0, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Score this candidate against the job on 3 dimensions (0-100 each): skills_score, experience_score, projects_score. Also return matched_skills (array) and missing_skills (array) vs the job requirements. Return ONLY JSON.' }, { role: 'user', content: 'JOB: ' + $('Get Job For Scoring (Supabase)').first().json.title + ' | Required skills: ' + ($('Get Job For Scoring (Supabase)').first().json.skills || []).join(', ') + ' | JD: ' + $('Get Job For Scoring (Supabase)').first().json.description + '\\n\\nCANDIDATE RESUME:\\n' + $('Document Cleaning').first().json.resume_text } ] }) }}",
