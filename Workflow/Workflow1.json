    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": false, \"error\": \"title and department are required\" } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "dc0b6da3-3b46-4408-8cd9-1675a2e58787",
      "name": "Respond - Invalid Input",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        -48,
        544
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.mistral.ai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'mistral-large-latest', temperature: 0.4, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'You are an expert technical recruiter. Given a job title, department, location and experience level, produce a complete job posting. Return ONLY valid JSON with keys: description (string, full JD in markdown), skills (array of strings), experience_level (string), summary (string, 1 line).' }, { role: 'user', content: 'Title: ' + $json.body.title + '\\nDepartment: ' + $json.body.department + '\\nLocation: ' + ($json.body.location || 'Not specified') + '\\nExperience Level: ' + ($json.body.experience_level || 'Not specified') + '\\nExtra notes: ' + ($json.body.notes || 'None') } ] }) }}",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "id": "66642cd9-13e9-4770-ad8e-f31a4c0383c5",
      "name": "AI Agent - Generate JD + Skills + Experience",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -32,
        288
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_MISTRAL_CREDENTIAL_ID",
          "name": "Mistral API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices[0].message.content;\nlet parsed;\ntry { parsed = JSON.parse(raw); } catch (e) { parsed = { description: raw, skills: [], experience_level: '' }; }\nconst input = $('Create Job (Webhook)').first().json.body;\nreturn [{ json: {\n  title: input.title,\n  department: input.department,\n  location: input.location || '',\n  experience_level: parsed.experience_level || input.experience_level || '',\n  skills: parsed.skills || [],\n  description: parsed.description || '',\n  created_by: input.created_by || null\n} }];"
      },
      "id": "4d8dec84-24cc-4fd5-9dea-a2cfd12820f4",
      "name": "Parse JD/Skills/Experience",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        288
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.mistral.ai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'mistral-large-latest', temperature: 0, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'You are a DEI and job-quality auditor. Review the job description for biased/exclusionary language, unrealistic requirements and clarity. Return ONLY JSON: { \"pass\": boolean, \"quality_score\": number (0-100), \"issues\": array of strings, \"suggestions\": string }. pass=true only if quality_score >= 75 and no bias issues.' }, { role: 'user', content: JSON.stringify($json) } ] }) }}",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "id": "8708fb41-751e-4be8-9c7e-a5e20a2eb246",
      "name": "AI Bias & Quality Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        512,
        288
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_MISTRAL_CREDENTIAL_ID",
          "name": "Mistral API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices[0].message.content;\nlet review; try { review = JSON.parse(raw); } catch(e) { review = { pass: true, quality_score: 100, issues: [], suggestions: '' }; }\nconst job = $('Parse JD/Skills/Experience').first().json;\nreturn [{ json: { ...job, review } }];"
      },
      "id": "48860c28-7306-466c-bb22-613e98aba404",
      "name": "Parse Quality Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        288
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.review.pass }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "bff79403-cc0f-473e-bab4-8bae149381b2",
      "name": "Quality Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        912,
        288
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.mistral.ai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'mistral-large-latest', temperature: 0.3, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Rewrite the job description fixing the listed issues. Return ONLY JSON with keys: description, skills (array), experience_level.' }, { role: 'user', content: 'Original: ' + $json.description + '\\nIssues to fix: ' + JSON.stringify($json.review.issues) + '\\nSuggestions: ' + $json.review.suggestions } ] }) }}",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "id": "77ad9e87-3ba2-4e9f-9ddb-25e96dfac2f3",
      "name": "AI Improve JD",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        944,
        560
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_MISTRAL_CREDENTIAL_ID",
          "name": "Mistral API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices[0].message.content;\nlet parsed; try { parsed = JSON.parse(raw); } catch(e) { parsed = {}; }\nconst job = $('Parse Quality Check').first().json;\nreturn [{ json: { ...job, description: parsed.description || job.description, skills: parsed.skills || job.skills, experience_level: parsed.experience_level || job.experience_level } }];"
      },
